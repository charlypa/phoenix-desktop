{
    "$schema": "../node_modules/@tauri-apps/cli/schema.json",
    "productName": "Phoenix Code Experimental Build",
    "version": "4.1.1",
    "identifier": "io.phcode.dev",
    "build": {
        "beforeBuildCommand": "",
        "beforeDevCommand": "npm run _watch_src-node",
        "devUrl": "http://localhost:8000/src/",
        "frontendDist": "../src/"
    },
    "bundle": {
        "active": true,
        "category": "DeveloperTool",
        "copyright": "Copyright (c) 2022 - present Core.ai",
        "createUpdaterArtifacts": "v1Compatible",
        "publisher": "Core.ai",
        "homepage": "https://phcode.io",
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "shortDescription": "Phoenix Code Experimental Build",
        "longDescription": "Phoenix Code Experimental Build",
        "macOS": {
            "entitlements": "../entitlements.plist",
            "exceptionDomain": "localhost",
            "frameworks": [],
            "providerShortName": null,
            "signingIdentity": null
        },
        "resources": [
            "src-node/*"
        ],
        "targets": [
            "appimage",
            "nsis",
            "app",
            "dmg"
        ],
        "windows": {
            "certificateThumbprint": "09c46b557f16fcdd49b2706c9858e82018cba219",
            "digestAlgorithm": "sha256",
            "timestampUrl": "http://timestamp.globalsign.com/tsa/advanced",
            "nsis": {
                "displayLanguageSelector": true,
                "template": "./src/bundle/windows/nsis/installer.nsi",
                "languages": [
                    "English",
                    "Afrikaans",
                    "Albanian",
                    "Arabic",
                    "Armenian",
                    "Asturian",
                    "Basque",
                    "Belarusian",
                    "Bosnian",
                    "Breton",
                    "Bulgarian",
                    "Catalan",
                    "Corsican",
                    "Croatian",
                    "Czech",
                    "Danish",
                    "Dutch",
                    "Esperanto",
                    "Estonian",
                    "Farsi",
                    "Finnish",
                    "French",
                    "Galician",
                    "Georgian",
                    "German",
                    "Greek",
                    "Hebrew",
                    "Hindi",
                    "Hungarian",
                    "Icelandic",
                    "Indonesian",
                    "Irish",
                    "Italian",
                    "Japanese",
                    "Korean",
                    "Kurdish",
                    "Latvian",
                    "Lithuanian",
                    "Luxembourgish",
                    "Macedonian",
                    "Malay",
                    "Mongolian",
                    "Norwegian",
                    "NorwegianNynorsk",
                    "Pashto",
                    "Polish",
                    "Portuguese",
                    "PortugueseBR",
                    "Romanian",
                    "Russian",
                    "ScotsGaelic",
                    "Serbian",
                    "SerbianLatin",
                    "SimpChinese",
                    "Slovak",
                    "Slovenian",
                    "Spanish",
                    "SpanishInternational",
                    "Swedish",
                    "Tatar",
                    "Thai",
                    "TradChinese",
                    "Turkish",
                    "Ukrainian",
                    "Uzbek",
                    "Vietnamese",
                    "Welsh"
                ]
            }
        }
    },
    "app": {
        "security": {
            "csp": null,
            "dangerousDisableAssetCspModification": true,
            "capabilities": []
        },
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "fullscreen": false,
                "height": 900,
                "minHeight": 600,
                "resizable": true,
                "title": "Phoenix Code Experimental Build",
                "width": 1366,
                "minWidth": 800,
                "dragDropEnabled": false
            },
            {
                "label": "healthData",
                "title": "Health data window",
                "url": "http://localhost:8000/src/desktop-metrics.html",
                "visible": false,
                "dragDropEnabled": false
            },
            {
                "label": "fileDrop",
                "title": "Drop To Open Files",
                "url": "http://localhost:8000/src/drop-files.html",
                "visible": false,
                "dragDropEnabled": true,
                "decorations": false
            }
        ]
    },
    "plugins": {
        "cli": {
            "description": "Phoenix Code cli",
            "longDescription": "CLI to open project, run tests amd other things",
            "args": [
                {
                    "name": "quit-when-done",
                    "description": "Quit after whatever the task assigned from CLI is done.",
                    "short": "q"
                },
                {
                    "name": "run-tests",
                    "description": "run all tests in the given category",
                    "takesValue": true
                }
            ]
        },
        "updater": {
            "active": true,
            "windows": {
                "installMode": "passive"
            },
            "endpoints": [
                "https://updates.phcode.io/tauri/update-latest-experimental-build.json"
            ],
            "dialog": false,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QTY2RjMxQUIzQkU0RDQKUldUVTVEdXJNVyttWmc2ODNSODlVcmZhS0dFRW1mYnBkaytvTDcrSDJXSlhYOHVrUWRyaXhHRjcK"
        }
    }
}
